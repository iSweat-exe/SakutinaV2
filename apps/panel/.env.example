# Supabase project used for sign-in (Discord OAuth). Public values.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Display name of the managed Discord server (the bot is single-server).
NEXT_PUBLIC_GUILD_NAME=Uwu Server

# Where the panel reads the bot's health (GET /api/v1/health). Server-side only.
BOT_API_URL=https://sakutina.isweat.pro

# Discord id of the managed server (same variable as the bot's). Server-side only.
# The panel reads the database with each admin's own session; admins are listed in
# the `panel_admin` table (see README, "Panneau et base de données").
DISCORD_PRIMARY_GUILD_ID=1317931106993180763
