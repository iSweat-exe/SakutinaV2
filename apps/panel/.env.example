# Supabase project used for sign-in (Discord OAuth). Public values.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Display name of the managed Discord server (the bot is single-server).
NEXT_PUBLIC_GUILD_NAME=Uwu Server

# Where the panel reads the bot's health (GET /api/v1/health). Server-side only.
BOT_API_URL=https://sakutina.isweat.pro
