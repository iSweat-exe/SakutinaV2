# Discord application token. Never commit a real token.
DISCORD_TOKEN=

# Required only when registering guild slash commands manually.
DISCORD_APPLICATION_ID=1566435489974845590

# Uwu Server — le bot est mono-serveur Discord. À configurer sur Render, jamais en dur.
DISCORD_PRIMARY_GUILD_ID=1317931106993180763

# Rôles Discord (IDs séparés par des virgules) reconnus comme admin / modérateur du bot,
# en plus des permissions Discord (propriétaire, Administrator, Moderate Members).
ADMIN_ROLE_IDS=
MODERATOR_ROLE_IDS=

# Phaéthon (profilage) — salon où publier les alertes aux administrateurs (optionnel).
ALERT_CHANNEL_ID=
# Suivi de la présence (statut, jeux). Active l'intention privilégiée « Presence » :
# l'activer d'abord dans le portail développeur Discord (Bot > Privileged Gateway Intents),
# sinon la connexion est refusée. Désactivé par défaut.
TRACK_PRESENCE=false

# Chaîne de connexion PostgreSQL (Supabase, mode « session pooler » ou directe).
# Obligatoire en production ; sans elle, stockage en mémoire (données perdues au redémarrage).
DATABASE_URL=

# Render supplies PORT automatically; 3000 is the local default.
PORT=3000
NODE_ENV=development
